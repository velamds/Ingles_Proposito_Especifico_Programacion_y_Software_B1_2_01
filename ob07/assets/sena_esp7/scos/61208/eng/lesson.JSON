xt", "content": "Maybe next time..."}], "allowed_attempts": 2}}], "questions": [{"responses": [{"id": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 1}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "template_override": 1, "type": "RSLT"}, {"id": 12, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "correct_feedback": "Correct!"}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Reading"}]}], "questions": [{"responses": [{"id": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 1}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "enpe7n6le01ob07re7pdf01.pdf"}]}]}], "template_override": 1, "type": "DWS"}], "stimuli": [{"type": "welcome", "contents": [{}], "_data": [], "template_override": 1, "id": 0}, {"id": 1, "contents": [{"type": "slideshow", "value": {"images": [{"id": 0, "image": "enpe7n6le01ob07re2img01.jpg", "text": "<b>Mrs. Adams:</b> Good morning! Today we are going to talk about the Response Object in ASP.NET. How would you define this type of object?<br>\n<b>Amy: </b>  Well\u2026 Response Object in ASP.NET is understood as the server's response or output sent to the client request. Even if this object is not vital for page processing, it still offers different functionalities that are important when sending output. For example, it provides cookie features to set cookie values, and it uses the Redirect Method that can transfer a client to other URL.<br>\n<b>Mrs. Adams: </b>  That's right, Amy.  You should also bear in mind that Response.Redirect performs a round trip when executing. What are other methods of the Response Object?<br>", "time": "100"}, {"id": 1, "image": "enpe7n6le01ob07re2img02.jpg", "text": "<b>Eddie: </b>  Regarding methods, there is one called AppendToLog; it is used to add strings to entries at the end of the Web server log.<br>We also have the AppendCookie, which is understood as a method that adds HTTP cookies to the inherent cookie collection. Finally, it is also possible to mention BinaryWrite, which is in charge of writing a series of binary characters to the HTTP output flow. <br>\n<b>Mrs. Adams: </b>  I would add some more. We can mention, for instance, Clear content, which deletes all buffered HTML output; End, which interrupts processing files to rise an EndRequest event; and Flush, which allows sending buffered output directly, among others. As you may know, the Response Object is composed of some properties too; which ones do you recall? <br>", "time": "53500"}, {"id": 2, "image": "enpe7n6le01ob07re2img03.jpg", "text": "<b>Amy: </b>  By way of example, we could name CacheControl; it specifies a header to declare if the proxy server is able to cache the output that is produced or not. There also is ContentType. It sets the HTTP content type to send. LCID defines aspects such as dates, time, and currency according to a specific geographical position. <br>\n<b>Eddie: </b>  Do not forget about Status; the status line that is returned to the client machine is defined by this property. <br>", "time": "112500"}], "coverimg": "enpe7n6le01ob07re2img01.jpg", "audiosrc": "enpe7n6le01ob07re2aud01"}}], "_data": [], "title": "", "template_override": 1, "type": "audio"}], "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}]}