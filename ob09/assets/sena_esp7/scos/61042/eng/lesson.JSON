t": ""}], "type": "question"}]}], "template_override": 1, "type": "RSLT"}, {"id": 11, "stimuli_ids": [], "_data": [{"contents": [{"type": "text", "content": "Getting Acquainted with Client Side Coding in ASP.NET!"}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "Correct!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}], "type": "post_instructions"}, {"contents": [{"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Reading"}], "type": "learning_skills"}], "questions": [{"responses": [{"id": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "correct": 1}], "id": 0, "_data": [{"contents": [{"type": "pdf", "content": "enpe7n6le01ob09re7pdf01.pdf"}], "type": "question"}]}], "template_override": 1, "type": "DWS"}], "stimuli": [{"type": "welcome", "id": 0, "contents": [{}], "_data": [], "template_override": 1}, {"type": "audio", "_data": [], "title": "", "template_override": 1, "id": 1, "contents": [{"type": "slideshow", "value": {"images": [{"id": 0, "image": "enpe7n6le01ob09re2img01.jpg", "time": "100", "text": "<p><strong>Lecturer</strong>: So far, we have been exploring different ASP.NET programming features, but we haven&rsquo;t given much attention to client-side programming on this platform. You must know that ASP.NET pages and applications are not restricted to server-based tools or languages; there is also a wide variety of client-based tools available in ASP.NET. So let&rsquo;s start with a simple question: what aspects are included in client-side coding?</p>"}, {"id": 1, "image": "enpe7n6le01ob09re2img02.jpg", "time": "35000", "text": "<p>Well, there are essentially two aspects that are pretty important in this type of programming: client-side scripts, on the one hand, and side source coding, on the other. Client-side scripting makes reference to those programs that are run on the web by the user&rsquo;s web browser instead of using the web server; this type of scripts allows speeding up the page execution. So, ASP.NET provides different server controls that use client-side scripting in order to respond to the users&rsquo; request without needing to send a post back to the server. One clear example of this type of processing can be client-side data validation; for instance, a user can fill and validate the information in an email form field without making a round trip to the server.</p>\n<p>ASP.NET developers have been working hard to make server controls be able to execute scripts through different events; for instance, onblur, onfocus, onchange, onkeydown, onkeyup, and onserverclick, among others.</p>"}, {"id": 2, "image": "enpe7n6le01ob09re2img03.jpg", "time": "120000", "text": "<p>But, how is client source code written? Well, as we have discussed in recent sessions, there are specifically two types of files in which ASP.NET pages are written: the content file or markup file (.aspx) and the code-behind file. The content file holds the structure of a page, which is the whole of control tags of the page; and the code-behind file has the class definition.&nbsp; Once both files are executed, the content file is transformed into a page class; then, as a result of the combined data of this class, the class definition, and the system generated code, we get the executable code or assembly to process clients' requests.</p>"}], "coverimg": "enpe7n6le01ob09re2img01.jpg", "audiosrc": "enpe7n6le01ob09re2aud01"}}]}, {"type": "static", "_data": [], "title": "", "template_override": 1, "id": 2, "contents": [{"type": "img", "value": "011.jpg"}, {"type": "img", "value": "022.jpg"}, {"type": "img", "value": "033.jpg"}]}, {"type": "static", "_data": [], "title": "", "template_override": 1, "id": 3, "contents": [{"type": "img", "value": "01.jpg"}, {"type": "img", "value": "02.jpg"}, {"type": "img", "value": "03.jpg"}]}], "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}]}